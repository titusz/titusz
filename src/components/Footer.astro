---
/**
 * Site footer with social links and copyright.
 */
import Container from "@components/Container.astro";
import { SITE, SOCIALS } from "@consts";
import BackToTop from "@components/BackToTop.astro";

const iconClass =
  "group-hover:stroke-black group-hover:dark:stroke-white transition-colors duration-300 ease-in-out";
---

<footer class="animate">
  <Container>
    <div class="relative">
      <div class="absolute right-0 -top-20">
        <BackToTop />
      </div>
    </div>
    <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-between">
      <div>
        &copy; {new Date().getFullYear()} {`|`} {SITE.NAME}
      </div>
      <div class="flex flex-wrap gap-1 items-center">
        {
          SOCIALS.map((social) => (
            <a
              href={social.HREF}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.NAME}
              class="group size-8 flex items-center justify-center rounded-full"
            >
              {social.NAME === "github" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={iconClass}
                >
                  <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
                </svg>
              )}
              {social.NAME === "linkedin" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={iconClass}
                >
                  <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
                  <rect x="2" y="9" width="4" height="12" />
                  <circle cx="4" cy="4" r="2" />
                </svg>
              )}
              {social.NAME === "twitter" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={iconClass}
                >
                  <path d="M4 4l11.733 16h4.267l-11.733 -16z" />
                  <path d="M4 20l6.768 -6.768" />
                  <path d="M20 4l-7.364 7.364" />
                </svg>
              )}
              {social.NAME === "reddit" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={iconClass}
                >
                  <circle cx="12" cy="14" r="6" />
                  <circle cx="16" cy="13" r="0.5" fill="currentColor" />
                  <circle cx="8" cy="13" r="0.5" fill="currentColor" />
                  <path d="M10 17c.667.333 1.333.5 2 .5s1.333-.167 2-.5" />
                  <path d="M18 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" />
                  <path d="M17.5 8l-1.5 2" />
                  <path d="M12 8v4" />
                  <path d="M12 8l4-2" />
                </svg>
              )}
              {social.NAME === "telegram" && (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class={iconClass}
                >
                  <path d="M15 10l-4 4l6 6l4-16l-18 7l4 2l2 6l3-4" />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>
  </Container>
</footer>
