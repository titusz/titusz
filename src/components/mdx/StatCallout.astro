---
/**
 * Semantic statistic callout component for MDX content.
 * Renders as <aside role="note"> with structured value, label, and source citation.
 */

interface Props {
  value: string;
  label: string;
  source?: string;
  sourceUrl?: string;
}

const { value, label, source, sourceUrl } = Astro.props;
---

<aside class="stat-callout not-prose my-6 rounded-lg border border-black/10 dark:border-white/15 bg-black/[0.02] dark:bg-white/[0.03] p-5" role="note">
  <p class="text-2xl font-light text-black/80 dark:text-white/80">{value}</p>
  <p class="mt-1 text-sm text-black/60 dark:text-white/60">{label}</p>
  {source && (
    <cite class="mt-2 block text-xs not-italic text-black/40 dark:text-white/40">
      Source: {sourceUrl ? <a href={sourceUrl} class="underline hover:text-black dark:hover:text-white">{source}</a> : source}
    </cite>
  )}
</aside>
