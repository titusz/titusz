---
/**
 * Breadcrumb navigation showing site hierarchy.
 * Always starts with "Titusz" linked to home.
 * Includes BreadcrumbList JSON-LD for search engines.
 */
type BreadcrumbItem = {
  label: string;
  href?: string;
};

type Props = {
  items: BreadcrumbItem[];
};

const { items } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const breadcrumbList = [
  { name: "Titusz", url: siteUrl + "/" },
  ...items.map((item) => ({
    name: item.label,
    url: item.href ? siteUrl + item.href : undefined,
  })),
];
---

<nav class="text-[0.6rem] font-sans font-light text-black/50 dark:text-white/50 uppercase tracking-widest">
  <a href="/" class="hover:text-black dark:hover:text-white transition-colors duration-300">Titusz</a>
  {items.map((item) => (
    <>
      <span class="mx-1">/</span>
      {item.href ? (
        <a href={item.href} class="hover:text-black dark:hover:text-white transition-colors duration-300">{item.label}</a>
      ) : (
        <span>{item.label}</span>
      )}
    </>
  ))}
</nav>

<script is:inline type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbList.map((item, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": item.name,
    ...(item.url ? { "item": item.url } : {}),
  })),
})} />
