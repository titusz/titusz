---
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { SITE } from "@consts";
---

<header>
  <Container>
    <div class="flex flex-wrap gap-y-2 justify-between">
      <Link href="/" underline={false}>
        <div class="flex items-center gap-2 font-sans font-thin text-lg">
          <img
            src="https://gravatar.com/avatar/f483794c24324fbb3fae584cfdd52cf4?s=64"
            alt={SITE.NAME}
            width="24"
            height="24"
            class="rounded-full"
          />
          {SITE.NAME}
        </div>
      </Link>
      <nav class="flex items-center gap-1 text-[0.75em] font-sans !font-thin text-white">
        <Link href="/lab" underline={false}>
          lab
        </Link>
        <span class="opacity-30">
          |
        </span>
        <Link href="/stories" underline={false}>
          stories
        </Link>
        <span class="opacity-30">
          |
        </span>
        <button
          id="theme-toggle"
          aria-label="Toggle theme"
          class="group size-8 flex items-center justify-center rounded-full"
        >
          <svg
            id="theme-icon-light"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="hidden group-hover:stroke-white transition-colors duration-300 ease-in-out"
          >
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line>
            <line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg
            id="theme-icon-dark"
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="hidden group-hover:stroke-white transition-colors duration-300 ease-in-out"
          >
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </nav>
    </div>
  </Container>
</header>
