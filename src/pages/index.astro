---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { SITE, HOME, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const tils = (await getCollection("til"))
  .filter(entry => !entry.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_TILS_ON_HOMEPAGE);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <img
            src="/images/hero-landing.webp"
            alt="Charcoal sketch of a craftsman organizing scattered digital media fragments into structured, identified content"
            width="768"
            height="512"
            class="animate w-full rounded-sm"
            loading="eager"
          />
          <p class="animate">
            Chairman of the <Link href="https://iscc.foundation" external>ISCC Foundation</Link>
            and creator of the
            <Link href="https://iscc.codes" external>International Standard Content Code</Link>
            (ISO 24138:2024). Co-founder and CTO of
            <Link href="https://www.amlet.ai" external>Amlet</Link>,
            building content licensing infrastructure for the AI era.
            CEO of <Link href="https://craft.de" external>Craft AG</Link>.
          </p>
          <p class="animate">
            25+ years in digital media technology, distributed systems, and
            content identification. Based in Freiburg, Germany.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-light text-black/70 dark:text-white/70">
            Latest posts
          </h5>
          <Link href="/blog">
            See all posts
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-light text-black/70 dark:text-white/70">
            Recent TIL
          </h5>
          <Link href="/til">
            See all TIL
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {tils.map(entry => (
            <li>
              <ArrowCard entry={entry} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-light text-black/70 dark:text-white/70">
            Projects
          </h5>
          <Link href="/projects">
            See all projects
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {projects.map(project => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-4">
        <h5 class="font-light text-black/70 dark:text-white/70">
          Connect
        </h5>
        <article>
          <p>
            Find me on social media or send me an email.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
