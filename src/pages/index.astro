---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { SITE, HOME } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const tils = (await getCollection("til"))
  .filter(entry => !entry.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_TILS_ON_HOMEPAGE);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <img
            src="/images/hero-landing.webp"
            alt="Charcoal sketch of a craftsman organizing scattered digital media fragments into structured, identified content"
            width="768"
            height="512"
            class="animate w-full rounded-sm"
            loading="eager"
          />
          <h5 class="animate">Bio</h5>
          <p class="animate">
            Techno-creative entrepreneur and software developer with 25+ years in
            digital media technology. Creator of the
            <Link href="https://github.com/iscc" external>International Standard Content Code (ISCC)</Link>
            published as <Link href="https://www.iso.org/standard/77899.html" external>ISO 24138:2024</Link> and chairman of the
            <Link href="https://iscc.io" external>ISCC Foundation</Link>. CEO of <Link href="https://craft.de" external>Craft AG</Link>
            and Co-founder and CTO of <Link href="https://www.amlet.ai" external>Amlet</Link>,
            building content infrastructure for the age of agents.
          </p>
          <p class="animate">
            Passionate about open source, decentralized technologies, and peer-to-peer architectures. Based in Freiburg, Germany.
          </p>
          <blockquote class="animate text-black/50 dark:text-white/50">
            "Always listen to experts. They'll tell you what can't be done, and why. Then do it."
            <footer class="not-italic text-[0.85em] mt-1">― Robert A. Heinlein</footer>
          </blockquote>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-light text-black/70 dark:text-white/70">
            Latest posts
          </h5>
          <Link href="/blog">
            See all posts
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-light text-black/70 dark:text-white/70">
            Recent TIL
          </h5>
          <Link href="/til">
            See all TIL
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {tils.map(entry => (
            <li>
              <ArrowCard entry={entry} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-light text-black/70 dark:text-white/70">
            Projects
          </h5>
          <Link href="/projects">
            See all projects
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {projects.map(project => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>

    </div>
  </Container>
</PageLayout>
