---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { SITE, HOME } from "@consts";

const stories = (await getCollection("stories"))
  .filter(entry => !entry.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_STORIES_ON_HOMEPAGE);

const labs = (await getCollection("lab"))
  .filter(entry => !entry.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_LABS_ON_HOMEPAGE);

---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION} image="/og/home.png">
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "https://titusz.org/#person",
    "name": "Titusz Pan",
    "url": "https://titusz.org",
    "jobTitle": "CEO & Chairman",
    "worksFor": [
      { "@type": "Organization", "name": "Craft AG" },
      { "@type": "Organization", "name": "ISCC Foundation" },
      { "@type": "Organization", "name": "Amlet" },
    ],
    "sameAs": [
      "https://github.com/titusz",
      "https://www.linkedin.com/in/titusz",
      "https://x.com/titusz",
    ],
    "knowsAbout": ["Content Identification", "ISCC", "ISO 24138", "Digital Media Technology"],
  })} />
  <Container>
    <div class="space-y-16">
      <section>
        <h1 class="animate text-2xl font-normal text-black/70 dark:text-white/70 mb-4">
          Sparks, craft, and working code
        </h1>
        <div class="lightbox animate">
          <img
            src="/images/hero-landing.avif"
            alt="Expressionist painting of a man at a work table organizing scattered digital media fragments into structured, identified content"
            width={1920}
            height={1288}
            class="w-full rounded-lg"
            loading="eager"
          />
        </div>
        <article class="bio-card animate mt-4 rounded-lg border border-black/15 dark:border-white/20 bg-black/[0.02] dark:bg-white/[0.03] p-5 sm:p-6 space-y-4 text-[20px]">
          <div class="profile-crossfade float-left mr-4 mb-2 relative" style="width:var(--profile-w)">
            <img
              src="/images/titusz-pan.webp"
              alt="Portrait of Titusz Pan"
              width="128"
              height="168"
              class="block w-full rounded-sm border border-black/15 dark:border-white/20 transition-opacity duration-700 ease-in-out"
            />
            <img
              src="/images/titusz-pan-le.webp"
              alt="Portrait of Titusz Pan"
              width="128"
              height="168"
              class="profile-alt absolute inset-0 w-full h-full rounded-sm border border-black/15 dark:border-white/20 object-cover transition-opacity duration-700 ease-in-out"
            />
          </div>
          <p class="!mt-0">
            <span class="small-caps tracking-wide text-black/90 dark:text-white/90">Titusz Pan</span> — Entrepreneur, engineer, and creative with 25+ years in digital media technology. Creator of the International Standard Content Code (ISCC), published as ISO 24138:2024, and chairman of the ISCC Foundation. DIN expert for ISO/TC 46/SC 9. CEO of Craft AG and CTO of Amlet, building content infrastructure for the age of agents.
          </p>
          <p>
            Passionate about open source, decentralized technologies, and making content machine-readable at scale. Based in Freiburg, Germany.
          </p>
          <blockquote class="text-[0.85em] text-black/50 dark:text-white/50">
            "Always listen to experts. They'll tell you what can't be done, and why. Then do it."
            <footer class="not-italic text-[0.85em] mt-1">― Robert A. Heinlein</footer>
          </blockquote>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-light text-black/70 dark:text-white/70">
            From the lab
          </h5>
          <Link href="/lab">
            See all experiments
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {labs.map(entry => (
            <li>
              <ArrowCard entry={entry} />
            </li>
          ))}
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h5 class="font-light text-black/70 dark:text-white/70">
            Stories
          </h5>
          <Link href="/stories">
            See all stories
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {stories.map(entry => (
            <li>
              <ArrowCard entry={entry} />
            </li>
          ))}
        </ul>
      </section>

    </div>
  </Container>
</PageLayout>

<style>
  .profile-crossfade {
    --profile-w: 5.5rem;
  }
  @media (min-width: 640px) {
    .profile-crossfade {
      --profile-w: 6.5rem;
    }
  }
  .profile-alt {
    opacity: 0;
  }
  .profile-crossfade:hover .profile-alt {
    opacity: 1;
  }
</style>
