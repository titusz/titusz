---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import Breadcrumb from "@components/Breadcrumb.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await post.render();
---

<PageLayout title={post.data.title} description={post.data.description}>
  <Container>
    <div class="animate">
      <Breadcrumb items={[{ label: "Blog", href: "/blog" }, { label: post.data.shortTitle ?? post.data.title }]} />
    </div>
    <div class="space-y-2 mt-4 mb-6">
      <div class="animate text-2xl font-normal text-black/70 dark:text-white/70">
        {post.data.title}
      </div>
      <div class="animate flex items-center gap-1.5 font-sans font-thin text-[0.65rem] uppercase tracking-widest">
        <span><FormattedDate date={post.data.date} /></span>
        <span>&bull;</span>
        <span>{readingTime(post.body)}</span>
      </div>
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>