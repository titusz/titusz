---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import Breadcrumb from "@components/Breadcrumb.astro";

export async function getStaticPaths() {
  const entries = (await getCollection("lab"))
    .filter(entry => !entry.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: entry,
  }));
}
type Props = CollectionEntry<"lab">;

const entry = Astro.props;
const { Content } = await entry.render();
const ogImage = `/og/lab/${entry.slug}.png`;
---

<PageLayout title={entry.data.title} description={entry.data.description} image={ogImage}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": entry.data.title,
    "description": entry.data.description,
    "datePublished": entry.data.date.toISOString(),
    "image": new URL(ogImage, Astro.site).toString(),
    "author": {
      "@type": "Person",
      "name": "Titusz Pan",
      "url": "https://titusz.org",
    },
  })} />
  <Container>
    <div class="animate">
      <Breadcrumb items={[{ label: "Lab", href: "/lab" }, { label: entry.data.shortTitle ?? entry.data.title }]} />
    </div>
    <div class="space-y-2 mt-4 mb-6">
      <div class="animate text-2xl font-normal text-black/70 dark:text-white/70">
        {entry.data.title}
      </div>
      <div class="animate flex flex-wrap items-center gap-x-1.5 gap-y-2 font-sans font-thin text-[0.65rem] uppercase tracking-widest">
        <span><FormattedDate date={entry.data.date} /></span>
        <span>&bull;</span>
        <span>{readingTime(entry.body)}</span>
        {entry.data.tags && (
          <>
            <span>&bull;</span>
            {entry.data.tags.map(tag => (
              <span class="small-caps leading-none px-1.5 pt-[1px] pb-[5px] rounded-sm bg-black/5 dark:bg-white/10 text-black/85 dark:text-white/85">
                {tag}
              </span>
            ))}
          </>
        )}
      </div>
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>
