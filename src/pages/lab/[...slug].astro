---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";

export async function getStaticPaths() {
  const entries = (await getCollection("lab"))
    .filter(entry => !entry.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: entry,
  }));
}
type Props = CollectionEntry<"lab">;

const entry = Astro.props;
const { Content } = await entry.render();
---

<PageLayout title={entry.data.title} description={entry.data.description}>
  <Container>
    <div class="animate">
      <BackToPrev href="/lab">
        Back to Lab
      </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex items-center gap-1.5 font-sans">
        <div class="text-sm">
          <FormattedDate date={entry.data.date} />
        </div>
        &bull;
        <div class="text-sm">
          {readingTime(entry.body)}
        </div>
      </div>
      <div class="animate text-2xl font-light text-black/70 dark:text-white/70">
        {entry.data.title}
      </div>
      {entry.data.tags && (
        <div class="animate flex gap-2 text-sm font-sans">
          {entry.data.tags.map(tag => (
            <span class="small-caps leading-none px-1.5 pt-[2px] pb-[6px] rounded-sm bg-black/5 dark:bg-white/10">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
    <article class="animate">
      <Content />
    </article>
  </Container>
</PageLayout>
