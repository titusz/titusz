---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import { PUBLICATIONS } from "@consts";

const data = await getCollection("publications");

type Acc = {
  [year: string]: CollectionEntry<"publications">[];
};

const pubs = data
  .sort((a, b) => b.data.year - a.data.year)
  .reduce((acc: Acc, pub) => {
    const year = pub.data.year.toString();
    if (!acc[year]) {
      acc[year] = [];
    }
    acc[year].push(pub);
    return acc;
  }, {});

const years = Object.keys(pubs).sort((a, b) => parseInt(b) - parseInt(a));
---

<PageLayout title={PUBLICATIONS.TITLE} description={PUBLICATIONS.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate">
        <Breadcrumb items={[{ label: "Publications" }]} />
      </div>
      <div class="space-y-8">
        {years.map(year => (
          <section class="animate space-y-4">
            <div class="font-light text-black/70 dark:text-white/70">
              {year}
            </div>
            <ul class="space-y-4">
              {pubs[year].map(pub => (
                <li class="space-y-1">
                  <div class="font-light text-black/70 dark:text-white/70">
                    {pub.data.url ? (
                      <Link href={pub.data.url} external>
                        {pub.data.title}
                      </Link>
                    ) : (
                      pub.data.title
                    )}
                  </div>
                  <div class="text-sm">
                    {pub.data.authors}
                  </div>
                  <div class="text-sm italic">
                    {pub.data.venue}
                    {pub.data.doi && (
                      <span>
                        {" — "}
                        <Link href={`https://doi.org/${pub.data.doi}`} external>
                          DOI
                        </Link>
                      </span>
                    )}
                  </div>
                  <div class="text-sm">
                    {pub.data.description}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </Container>
</PageLayout>
